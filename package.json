    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.60.0",
    "material-icon-theme": "^5.39.0",
